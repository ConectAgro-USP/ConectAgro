## =========================
## App
## =========================
# dev ou prod
APP_FLAVOR=dev

## =========================
## Banco de Dados (PostgreSQL)
## =========================

## Valores de exemplo para desenvolvimento local.
POSTGRES_USER=conectagro
POSTGRES_PASSWORD=agroconecta #troque para uma senha de verdade em produção
POSTGRES_DB=conectagro
POSTGRES_PORT=5432

## Usada pelo backend. Em Docker Compose, o host "db" é sobrescrito automaticamente.
## Rodando o backend fora do Docker, troque "db" por "localhost".
DATABASE_URL=postgresql+psycopg://conectagro:agroconecta@db:5432/conectagro

## =========================
## Backend (FastAPI)
## =========================
BACKEND_PORT=8000

## Origens autorizadas a chamar a API diretamente (fora do proxy do Vite), separadas por vírgula.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

## Para onde o usuário é redirecionado após o login/logout via OAuth.
FRONTEND_URL=http://localhost:5173

## =========================
## Autenticação (OAuth - Google)
## =========================

## NUNCA SOB HIPÓTESE ALGUMA, COMMITE ELES!!!
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


## URL de descoberta OpenID do Google, não precisa trocar.
GOOGLE_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration

## Chaves usadas para assinar a sessão do OAuth e os tokens de acesso emitidos.
## NUNCA SOB HIPÓTESE ALGUMA, COMMITE ELES!!!
SESSION_SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

## =========================
## Frontend (Vite)
## =========================
VITE_APP_NAME=
