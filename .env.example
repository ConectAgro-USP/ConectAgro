## Copie para .env e preencha. O .env guarda segredos e não deve ser commitado.

## =========================
## App
## =========================
## dev ou prod
APP_FLAVOR=dev

## =========================
## Banco de Dados (PostgreSQL)
## =========================

## Exemplos para dev local. Se trocar a senha, use uma URL-safe, pois ela entra crua no DATABASE_URL.
POSTGRES_USER=conectagro
POSTGRES_PASSWORD=agroconecta
POSTGRES_DB=conectagro
POSTGRES_PORT=5432

## Usada pelo backend fora do Docker. No Compose, o docker-compose.yml monta a URL com o host db.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

## true mostra cada SQL no console, só para depurar em dev.
DB_ECHO=false

## =========================
## Backend (FastAPI)
## =========================
## Porta publicada pelo make up. O proxy do Vite e o make dev-server usam sempre a 8000.
BACKEND_PORT=8000

## Origens autorizadas a chamar a API diretamente (fora do proxy do Vite), separadas por vírgula.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

## Base da Redirect URI do Google e destino pós-login. O make up usa a porta do backend.
FRONTEND_URL=http://localhost:5173

## =========================
## Autenticação (OAuth - Google)
## =========================

## Client OAuth criado no Google Cloud Console, no passo 2 do SETUP.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

## Assinam a sessão do OAuth e os JWT. Use no mínimo 32 caracteres, gerados como no passo 1 do SETUP.
SESSION_SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
